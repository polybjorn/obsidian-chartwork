{
  "name": "obsidian-chartwork",
  "version": "1.0.0",
  "private": true,
  "description": "Draw charts from Bases views, code blocks and scripts in your theme's colors.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "preview": "npm run build && node scripts/preview.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "keywords": [
    "obsidian",
    "charts",
    "bases",
    "chart.js"
  ],
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.6.1",
    "chartjs-chart-sankey": "0.19.1",
    "chartjs-plugin-annotation": "3.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "flatted": "^3.4.0",
    "ajv@^6": "^6.14.0",
    "minimatch@^3": {
      ".": "^3.1.3",
      "brace-expansion": "^1.1.21"
    },
    "brace-expansion": "^5.0.8",
    "moment": "^2.31.0"
  }
}
