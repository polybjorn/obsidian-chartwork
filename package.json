{
  "name": "obsidian-chartwork",
  "version": "0.0.0",
  "private": true,
  "description": "Charts from Bases views, code blocks and scripts, drawn in your theme's colours.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "node --test tests/"
  },
  "keywords": [
    "obsidian",
    "charts",
    "bases",
    "chart.js"
  ],
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "yaml": "^2.8.3",
    "flatted": "^3.4.0",
    "ajv@^6": "^6.14.0",
    "minimatch@^3": "^3.1.3",
    "brace-expansion": "^5.0.8",
    "moment": "^2.31.0"
  }
}
